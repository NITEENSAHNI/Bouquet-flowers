{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tanstack-start-app",
	"compatibility_date": "2025-09-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	"d1_databases": [
		{
			"binding": "bouquet_db",
			"database_name": "bouquet-db",
			"database_id": "e16edba1-c485-4639-bcfc-fbad28ac01fc",
			"remote": true
		}
	],
}